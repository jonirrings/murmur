{
  "compilerOptions": {
    "target": "ESNext",
    "jsx": "preserve",
    "jsxImportSource": "hono/jsx",
    "module": "ESNext",
    "lib": ["ESNext"],
    "types": ["node", "./worker-configuration.d.ts"],

    /* Bundler mode */
    "moduleResolution": "Bundler",
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true
  }
}
