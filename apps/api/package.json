{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply murmur-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply murmur-db --remote",
    "auth:generate": "pnpx --yes @better-auth/cli@latest generate --config src/auth.config.ts --output ../../packages/db/src/auth.schema.ts -y"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@murmur/api-types": "workspace:*",
    "@murmur/config": "workspace:*",
    "@murmur/db": "workspace:*",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "wrangler": "^4.129.0"
  }
}
