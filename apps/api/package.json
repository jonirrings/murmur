{
  "name": "@murmur/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface APIBindings",
    "dev": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy --minify",
    "auth:generate": "auth generate --output src/db/auth.schema.ts -y",
    "db:generate:local": "NODE_ENV=development drizzle-kit generate",
    "db:generate:remote": "NODE_ENV=production drizzle-kit generate",
    "db:studio:remote": "NODE_ENV=production drizzle-kit studio",
    "db:migrate:mock": "NODE_ENV=development drizzle-kit migrate",
    "db:migrate:local": "wrangler d1 migrations apply murmur-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply murmur-db --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "@murmur/api-types": "workspace:*",
    "@murmur/config": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@libsql/client": "catalog:",
    "@types/node": "^26.4.1",
    "auth": "catalog:",
    "drizzle-kit": "catalog:",
    "wrangler": "catalog:"
  }
}
